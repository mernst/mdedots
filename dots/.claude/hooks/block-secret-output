#!/usr/bin/env perl

# A Claude Code PreToolUse hook for the Bash tool.  It blocks a command that
# would print a credential into the transcript, such as `gh auth token`,
# `printenv` or `env` with no argument, `printenv GH_TOKEN`, or
# `echo "$GH_TOKEN"`.  A secret that appears in a tool result is stored in the
# transcript and sent to the model.
#
# Such a command is allowed if the pipeline that contains it discards or
# hashes its output:  `> /dev/null` (or `&> /dev/null`), or a pipe into
# `sha256sum` (or another `sha*sum`), `md5sum`, `b2sum`, or `wc`.  Text inside
# quotes or a here-document is not a command, so `grep 'gh auth token' FILE`
# is allowed.
#
# The hook reads the hook input JSON on standard input.  It exits with status
# 2, which blocks the command and shows standard error to the model, if it
# finds such a command.  Otherwise it exits with status 0.

use strict;
use warnings;
use JSON::PP;

my $input = do { local $/; <STDIN> };
my $data = eval { JSON::PP->new->decode($input) } or exit 0;
my $command = $data->{tool_input}{command} // '';
exit 0 if $command eq '';

# Matches the name of a variable that likely holds a credential.
my $secret_name = qr/(?i:[A-Za-z0-9_]*(?:TOKEN|SECRET|PASSWORD|PASSWD|API_?KEY|CREDENTIAL)[A-Za-z0-9_]*)/;

# Matches the start of a command that prints a credential.
my $secret_source = qr/
    \bgh\s+auth\s+token\b
  | \bprintenv\s*(?:$|[|;&>)])
  | \bprintenv\s+$secret_name\b
  | (?:^|[|;&(]\s*|\s)env\s*(?:$|[|;&>)])
  | \b(?:echo|printf)\b[^|;&\n]*\$\{?$secret_name\b
/x;

# Matches a redirection or a pipe that discards or hashes the output.
my $safe_sink = qr/
    (?:^|[\s0-9&])>\s*\/dev\/null\b
  | \|\s*(?:sha(?:1|224|256|384|512)sum|md5sum|b2sum|wc)\b
/x;

# Split the command into segments at unquoted `;`, `&&`, `||`, and newlines,
# and replace each quoted character and each here-document line by a space,
# so that only command text remains to be matched.  A pipeline stays in one
# segment, so that a sink later in the pipeline is found.
my @segments;
my $current = '';
my $quote = '';
my @heredocs;
my @lines = split /\n/, $command, -1;
for (my $i = 0; $i < @lines; $i++) {
  my $line = $lines[$i];
  if (@heredocs) {
    my $delimiter = $heredocs[0];
    shift @heredocs if $line =~ /^\t*\Q$delimiter\E$/;
    next;
  }
  my @chars = split //, $line;
  for (my $j = 0; $j < @chars; $j++) {
    my $c = $chars[$j];
    my $next = $j + 1 < @chars ? $chars[$j + 1] : '';
    if ($quote eq "'") {
      $quote = '' if $c eq "'";
      $current .= ($c eq "'") ? $c : ' ';
      next;
    }
    if ($quote eq '"') {
      if ($c eq '\\' && $next ne '') {
        $current .= '  ';
        $j++;
        next;
      }
      if ($c eq '"') {
        $quote = '';
        $current .= $c;
        next;
      }
      # Keep variable expansions inside double quotes, which print a value.
      if ($c eq '$') {
        my $rest = substr($line, $j);
        if ($rest =~ /^(\$\{?[A-Za-z0-9_]+\}?)/) {
          $current .= $1;
          $j += length($1) - 1;
          next;
        }
      }
      $current .= ' ';
      next;
    }
    if ($c eq '\\' && $next ne '') {
      $current .= '  ';
      $j++;
      next;
    }
    if ($c eq "'" || $c eq '"') {
      $quote = $c;
      $current .= $c;
      next;
    }
    if ($c eq '<' && $next eq '<') {
      my $rest = substr($line, $j);
      if ($rest =~ /^<<-?\s*(['"]?)([A-Za-z0-9_]+)\1/) {
        push @heredocs, $2;
        $current .= ' ' x length($&);
        $j += length($&) - 1;
        next;
      }
    }
    if ($c eq ';' || ($c eq '&' && $next eq '&') || ($c eq '|' && $next eq '|')) {
      push @segments, $current;
      $current = '';
      $j++ if $c ne ';';
      next;
    }
    $current .= $c;
  }
  # A newline inside quotes does not end a segment.
  if ($quote eq '') {
    push @segments, $current;
    $current = '';
  } else {
    $current .= ' ';
  }
}
push @segments, $current if $current ne '';

for my $segment (@segments) {
  if ($segment =~ $secret_source && $segment !~ $safe_sink) {
    (my $shown = $&) =~ s/^\s+|\s+$//g;
    print STDERR "Blocked: \"$shown\" would print a credential into the"
      . " transcript.  To test whether a credential exists, redirect the"
      . " output to /dev/null and use the exit status, or use"
      . " \`gh auth status\`.  To compare two credentials, compare their"
      . " hashes, as with \`| sha256sum\`.\n";
    exit 2;
  }
}
exit 0;
