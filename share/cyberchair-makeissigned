#!/usr/bin/env perl

# Creates guesses at "issigned" files.
# These should be deleted by hand if appropriate.

use strict;
use English;
$WARNING = 1;

use checkargs;
use util_daikon;


## Results for ISSTA 2006:
#
# These have a self-reference but are not signed:
#
# 111-1-issigned.txt
# 116-2-issigned.txt
# 120-3-issigned.txt
# 122-1-issigned.txt
# 126-3-issigned.txt
