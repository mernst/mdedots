#!/bin/bash

# Usage: crreview-trigger-neediest [--dry-run] [--verbose] [--file FILE]
#
# Comment "@coderabbitai review" on one open, non-draft pull request that needs
# a review:  the first PR in the queue file (described below) that still needs
# one.  The queue file lists the PRs that involve me (authored, assigned,
# commented, mentioned, reviewed, or with a review requested) and that needed a
# review when the queue file was written, ordered by how many non-merge commits
# CodeRabbit had not reviewed then, most first.  Merge commits and merge
# conflicts are ignored.  It is intended to be run hourly from cron, because
# CodeRabbit limits how many reviews it performs per hour.
#
#   --dry-run    do not comment and do not change the queue file; just report
#                which PR would be chosen
#   --verbose    list every PR that is ignored because CodeRabbit is not enabled
#                on it, every PR that has unreviewed non-merge commits, and
#                every queued PR that no longer needs a review
#   --file FILE  the queue file; the default is
#                ${XDG_STATE_HOME:-$HOME/.local/state}/crreview-trigger-neediest/candidates.txt
#
# Searching all PRs makes many network requests, so the candidates are kept in
# a queue file:  the URLs of all PRs that need a review, one per line, neediest
# first, such as "https://github.com/ORG/REPO/pull/123".  A run searches for
# candidates and writes the queue file only if the queue file does not exist or
# is empty.  Otherwise, a run re-checks only the first few PRs in the queue file,
# in one request.  The run requests a review of the first of them that still
# needs one, and it removes from the queue file the PRs before that one.  If
# none of them still needs a review, the run removes them all and re-checks the
# next few.
# A PR whose review was requested stays first in the queue file, so the next
# run re-checks it:  that run removes it if the review was performed or is still
# pending, and requests a review again if CodeRabbit replied that it was rate
# limited or that the PR changed.  Lines of the queue file that are not PR URLs
# are removed, with a warning.
#
# A PR is considered only if its repository is not archived and CodeRabbit is
# enabled on it, as shown by its having commented on or reviewed the PR.
# A PR is skipped if CodeRabbit's most recent reply to a review request says
# that the PR has too many files.  A PR is also skipped if a review was
# requested after its last commit, unless CodeRabbit replied that it was rate
# limited or that the PR changed.  Thus, each head commit is requested at most
# once, plus retries after those transient failures.
#
# The last commit that CodeRabbit reviewed is the latest one (among the PR's
# last 100 commits) indicated by any of:
#  * a PR review by CodeRabbit (made only when it has comments),
#  * the markers in CodeRabbit's summary comment, or
#  * a reply of "Review finished" or "Already reviewed the last commit" to a
#    review request; this indicates the last commit committed before the reply.

set -o errexit -o nounset -o pipefail

dry_run=false
verbose=false
queue_file="${XDG_STATE_HOME:-$HOME/.local/state}/crreview-trigger-neediest/candidates.txt"
while [ "$#" -gt 0 ]; do
  case "$1" in
    --dry-run) dry_run=true ;;
    --verbose) verbose=true ;;
    --file)
      if [ "$#" -lt 2 ]; then
        echo "${0##*/}: --file requires an argument" >&2
        exit 2
      fi
      queue_file=$2
      shift
      ;;
    *)
      echo "${0##*/}: unknown argument $1" >&2
      exit 2
      ;;
  esac
  shift
done

# shellcheck source=retry.sh
. "$(dirname "$0")/retry.sh"

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

# The first comments include CodeRabbit's summary comment; only its id is
# fetched here, because the summary comment is large.  The last comments
# include requests for reviews and CodeRabbit's replies to them.
pr_fields='fragment prFields on PullRequest {
  id
  url
  state
  isDraft
  locked
  repository { isArchived }
  commits(last: 100) { nodes { commit { oid committedDate parents { totalCount } } } }
  reviews(last: 20, author: "coderabbitai[bot]") { nodes { commit { oid } } }
  firstComments: comments(first: 100) { nodes { id author { login } } }
  lastComments: comments(last: 30) { nodes { author { login } createdAt body } }
}'
# shellcheck disable=SC2016 # "$q" and "$endCursor" are GraphQL variables
search_query='query($q: String!, $endCursor: String) {
  search(query: $q, type: ISSUE, first: 20, after: $endCursor) {
    pageInfo { hasNextPage endCursor }
    nodes { ...prFields }
  }
}
'"$pr_fields"
# Write to "$tmpdir/prs.json" every open, non-draft PR that involves me, as a
# JSON array of the objects that GitHub's GraphQL API returns for prFields.
search_prs() {
  for qualifier in involves reviewed-by review-requested; do
    retry gh api graphql --paginate -f q="is:pr is:open draft:false archived:false $qualifier:@me" -f query="$search_query"
  done | jq -s '[.[].data.search.nodes[]] | unique_by(.id)' > "$tmpdir/prs.json"
}

# How many queued PRs a run re-checks in one request.
recheck_batch_size=10

# Write to "$tmpdir/prs.json" the PRs whose URLs are the first lines of
# "$tmpdir/queue.txt", as a JSON array of the objects that GitHub's GraphQL API
# returns for prFields, each with an added key "queue_index":  the 0-based
# line number of its URL.  A URL that is not that of a PR is omitted.
# $1: how many lines to read.
fetch_queued_prs() {
  # The query is "query($u0: URI!, ...) { pr0: resource(url: $u0) { ...prFields } ... }".
  head -n "$1" "$tmpdir/queue.txt" |
    jq -R -s -c --arg fields "$pr_fields" '
      [splits("\n") | select(. != "")] as $urls
      | [range($urls | length)] as $indexes
      | {query: ("query(" + ($indexes | map("$u\(.): URI!") | join(", ")) + ") {\n"
                 + ($indexes | map("  pr\(.): resource(url: $u\(.)) { ...prFields }\n") | add)
                 + "}\n" + $fields),
         variables: ($indexes | map({"u\(.)": $urls[.]}) | add)}' > "$tmpdir/request.json"
  retry gh api graphql --input "$tmpdir/request.json" |
    jq '.data | to_entries
        | map(select(.value != null and .value.id != null)
              | .value + {queue_index: (.key | ltrimstr("pr") | tonumber)})' > "$tmpdir/prs.json"
}

# Write to "$tmpdir/needy.json" the PRs in "$tmpdir/prs.json" that need a
# review, as a JSON array of {url, count, oldest, queue_index}, neediest first.
# "queue_index" is copied from "$tmpdir/prs.json", or null if absent there.
find_needy_prs() {
  # Fetch the bodies of CodeRabbit's summary comments, 100 per request.
  jq -c '[.[].firstComments.nodes[] | select(.author.login == "coderabbitai") | .id]
         | . as $ids | range(0; length; 100) | $ids[.:. + 100]
         | {query: "query($ids: [ID!]!) { nodes(ids: $ids) { ... on IssueComment { id body } } }",
            variables: {ids: .}}' "$tmpdir/prs.json" > "$tmpdir/summary-requests.jsonl"
  while IFS= read -r request; do
    printf '%s\n' "$request" > "$tmpdir/request.json"
    retry gh api graphql --input "$tmpdir/request.json"
  done < "$tmpdir/summary-requests.jsonl" |
    jq -s '[.[].data.nodes[]] | map({(.id): .body}) | add // {}' > "$tmpdir/summaries.json"

  # CodeRabbit is enabled on a PR if CodeRabbit has commented on or reviewed the PR.
  jq 'map(.coderabbit_enabled = ((.reviews.nodes | length) > 0
            or any(.firstComments.nodes[], .lastComments.nodes[]; .author.login == "coderabbitai")))' \
    "$tmpdir/prs.json" > "$tmpdir/prs-coderabbit-enabled.json"
  if [ "$verbose" = true ]; then
    jq -r 'sort_by(.url)[] | select(.coderabbit_enabled | not)
           | "Ignoring \(.url): CodeRabbit is not enabled on it (it has never commented or reviewed)"' \
      "$tmpdir/prs-coderabbit-enabled.json"
  fi

  jq --slurpfile summaries "$tmpdir/summaries.json" '
    $summaries[0] as $summary_bodies
    # The commits that a summary comment says CodeRabbit has reviewed.
    | def summary_reviewed_oids:
        (scan("final_review_risk_coverage:(\\{[^}]*\\})")[0]
          | fromjson? | select(.kind == "reviewed") | .coveredCommitId),
        (scan("(?s)<!-- recent_review_start -->(.*?)<!-- recent_review_end -->")[0]
          | [scan("between [0-9a-f]{40} and ([0-9a-f]{40})")[0]] | last // empty),
        (scan("Last reviewed commit: ([0-9a-f]{40})")[0]);
    [ .[]
      | select(.coderabbit_enabled and .state == "OPEN" and (.isDraft | not) and (.locked | not)
               and (.repository.isArchived | not))
      | ([.firstComments.nodes[] | select(.author.login == "coderabbitai")][0].id) as $summary_id
      | [.lastComments.nodes[]
          | select(.author.login == "coderabbitai"
                   and (.body | test("Action performed|Action not completed")))] as $replies
      | select(($replies | last | .body // "") | test("exceed the limit") | not)
      | [.commits.nodes[].commit] as $commits
      # The last review request made after the head commit.
      | ([.lastComments.nodes[]
          | select((.body | test("^\\s*@coderabbitai (full )?review\\s*$"))
                   and .createdAt > $commits[-1].committedDate)] | last) as $request
      | select($request == null
               or (([$replies[] | select(.createdAt >= $request.createdAt)][0].body // "")
                   | test("rate limited|base or head changed")))
      | ([.reviews.nodes[].commit.oid]
         + [($summary_bodies[$summary_id // ""] // "") | summary_reviewed_oids]) as $reviewed_oids
      | ([$replies[] | select(.body | test("Review finished|Already reviewed the last commit"))
          | .createdAt]) as $reviewed_times
      | ([($commits | to_entries[] | select(.value.oid as $oid | $reviewed_oids | index($oid)) | .key),
          ($reviewed_times[] as $time
           | $commits | to_entries | map(select(.value.committedDate <= $time)) | last | .key // empty)]
         | max // -1) as $last_reviewed
      | [$commits[$last_reviewed + 1:][] | select(.parents.totalCount == 1)] as $unreviewed
      | select($unreviewed | length > 0)
      | {url, count: ($unreviewed | length), oldest: $unreviewed[0].committedDate, queue_index} ]
    # Most unreviewed commits first; among ties, the one that has waited longest.
    | sort_by(-.count, .oldest)
  ' "$tmpdir/prs-coderabbit-enabled.json" > "$tmpdir/needy.json"

  if [ "$verbose" = true ]; then
    jq -r '.[] | "\(.count)\t\(.url)"' "$tmpdir/needy.json"
  fi
}

# Write the scratch copy of the queue to the queue file.
save_queue() {
  mkdir -p "$(dirname "$queue_file")"
  cp "$tmpdir/queue.txt" "$queue_file.tmp"
  mv "$queue_file.tmp" "$queue_file"
}

# Changes are made to a scratch copy of the queue, so that --dry-run can
# discard them.  Whitespace (including carriage returns) is removed, and lines
# that are not PR URLs are discarded, because GitHub rejects them.
: > "$tmpdir/queue.txt"
if [ -f "$queue_file" ]; then
  sed 's/[[:space:]]//g; /^$/d' "$queue_file" > "$tmpdir/queue-all.txt"
  # Matches the URL of a PR, such as "https://github.com/ORG/REPO/pull/123".
  pr_url_regex='^https://github\.com/[^/]+/[^/]+/pull/[0-9]+$'
  grep -E -v "$pr_url_regex" "$tmpdir/queue-all.txt" |
    sed "s|^|${0##*/}: removing from the queue a line that is not a PR URL: |" >&2 || true
  grep -E "$pr_url_regex" "$tmpdir/queue-all.txt" > "$tmpdir/queue.txt" || true
fi

# Remove queued PRs that no longer need a review, until the first one does.
echo '[]' > "$tmpdir/needy.json"
while [ -s "$tmpdir/queue.txt" ]; do
  batch_size=$(head -n "$recheck_batch_size" "$tmpdir/queue.txt" | wc -l)
  fetch_queued_prs "$batch_size"
  find_needy_prs
  # The queue index of the first queued PR that still needs a review, if any.
  first_needy=$(jq -r 'map(.queue_index) | min // empty' "$tmpdir/needy.json")
  if [ -n "$first_needy" ]; then
    jq --argjson i "$first_needy" 'map(select(.queue_index == $i))' "$tmpdir/needy.json" > "$tmpdir/needy-first.json"
    mv "$tmpdir/needy-first.json" "$tmpdir/needy.json"
    stale_count=$first_needy
  else
    stale_count=$batch_size
  fi
  if [ "$verbose" = true ]; then
    head -n "$stale_count" "$tmpdir/queue.txt" |
      sed 's/.*/Removing & from the queue: it no longer needs a review/'
  fi
  tail -n +"$((stale_count + 1))" "$tmpdir/queue.txt" > "$tmpdir/queue-rest.txt"
  mv "$tmpdir/queue-rest.txt" "$tmpdir/queue.txt"
  if [ -n "$first_needy" ]; then
    break
  fi
done

# If the queue is empty, fill it.
if [ ! -s "$tmpdir/queue.txt" ]; then
  search_prs
  find_needy_prs
  jq -r '.[].url' "$tmpdir/needy.json" > "$tmpdir/queue.txt"
fi

# Now the first PR in the queue, if any, is the first element of needy.json.
url=$(jq -r '.[0].url // empty' "$tmpdir/needy.json")
if [ -z "$url" ]; then
  if [ "$dry_run" = false ]; then
    save_queue
  fi
  exit 0
fi
count=$(jq -r '.[0].count' "$tmpdir/needy.json")
if [ "$dry_run" = true ]; then
  echo "Would request a CodeRabbit review of $url ($count unreviewed non-merge commits)"
  exit 0
fi
# The chosen PR stays first in the queue; the next run re-checks it.
save_queue
gh pr comment "$url" --body "@coderabbitai review" > /dev/null
echo "Requested a CodeRabbit review of $url ($count unreviewed non-merge commits)"
