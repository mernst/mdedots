#!/bin/sh

while [ $# -gt 0 ]; do
  case $1 in
    --debug)
      DEBUG=--debug
      VERBOSE=true
      shift # past argument
      ;;
    --verbose)
      VERBOSE=true
      shift # past argument
      ;;
    -*)
      echo "Unknown option $1"
      exit 2
      ;;
    *)
      echo "Do not pass arguments to $0"
      exit 2
      ;;
  esac
done

### The MultiVersionControl program does most of the work!

if [ -n "$VERBOSE" ]; then
  verbose_arg="--print-directory --show"
fi
# shellcheck disable=SC2086
java -ea -cp "${HOME}"/java/plume-lib/multi-version-control/build/libs/multi-version-control-all.jar org.plumelib.multiversioncontrol.MultiVersionControl pull --search-prefix $DEBUG $verbose_arg

### Update my forks from upstream.

