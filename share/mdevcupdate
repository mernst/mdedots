# userid relates to how the clone is named locally, not the username at the hosting service
update_fork_with_hosting_and_userid() {
  org="$1"
  repo="$2"
  parentdir="$3"
  localname="$4"
  hosting="$5"
  userid="$6"
  if [ -z "$localname" ]; then
    localname="$repo"
  fi
  if [ -n "$VERBOSE" ]; then
    echo "update_fork_with_hosting_and_userid org=$org repo=$repo parentdir=$parentdir localname=$localname hosting=$hosting userid=$userid"
  fi
  if [ -z "$parentdir" ] || [ -z "$userid" ]; then
    echo "update_fork_with_hosting_and_userid: not enough arguments"
    echo "1=$1"
    echo "2=$2"
    echo "3=$3"
    echo "4=$4"
    echo "5=$5"
    echo "6=$6"
    exit 2
  fi
  if [ -d "$parentdir/$localname-fork-$userid" ]; then
    dir="$parentdir/$localname-fork-$userid"
  elif [ -d "$parentdir/$localname-fork-$userid-branch-main" ]; then
    dir="$parentdir/$localname-fork-$userid-branch-main"
  elif [ -d "$parentdir/$localname-fork-$userid-branch-master" ]; then
    dir="$parentdir/$localname-fork-$userid-branch-master"
  else
    dir=""
  fi

  if [ -n "$dir" ]; then
    git_pull_command="git pull -q --ff-only git@${hosting}:$org/$repo --tags"
    if [ -n "$VERBOSE" ]; then
      echo "cd $dir && $git_pull_command"
    fi
    # Doesn't use `git -C` because multiple git commands will be run in the directory.
    if [ -n "$DEBUG" ]; then
      # Run in the foreground.
      ( (cd "$dir" && fast_forward_to_upstream_and_push "git@${hosting}:$org/$repo") || echo "problem with $dir, perhaps in the command: $git_pull_command")
    else
      # Run in the background.
      ( (cd "$dir" && fast_forward_to_upstream_and_push "git@${hosting}:$org/$repo") || echo "problem with $dir, perhaps in the command: $git_pull_command") &
    fi
  fi
}

# Make every merge into the current branch of the clone in the current
# directory fast-forward-only, including the merge that `git pull` (such as
# the one that MultiVersionControl runs) performs, so the branch never gets a
# merge commit.  The setting applies only to that branch, so another branch,
# even one in a worktree of the same repository, still merges.
make_merges_fast_forward_only() {
  branch="$(git symbolic-ref --short HEAD)" \
    && git config "branch.$branch.mergeoptions" --ff-only
}

# Fast-forward the current branch of the clone in the current directory to
# upstream repository $1, then push it.  Fails, without pushing, if the
# branch cannot be fast-forwarded or if it has commits that upstream lacks.
# Also makes every later merge into the branch fast-forward-only.
fast_forward_to_upstream_and_push() {
  upstream="$1"
  make_merges_fast_forward_only
  if ! git pull -q --ff-only "$upstream" --tags; then
    pwd
    return 1
  fi
  if [ "$(git rev-parse HEAD)" != "$(git rev-parse FETCH_HEAD)" ]; then
    echo "$(pwd) has commits that $upstream lacks:"
    git log --oneline FETCH_HEAD..HEAD
    return 1
  fi
  git push -q && prune_stale_branches
}

# Prunes the repository of the clone in the current directory, so that
# `git branch -a` shows little more than the branches of its remotes.
# Like `git-orphaned-branches`, it treats a branch that is gone from its
# remote as done.  It:
#  * runs `git remote prune` on each remote except the one that `git fetch`
#    with no arguments fetches.  The caller is expected to have fetched that
#    remote with `--prune`, as `MultiVersionControl pull` and
#    `git pull --prune` do.  `git remote prune` deletes each remote-tracking
#    ref whose branch is gone from the remote.  Each remote is pruned
#    separately, so that a remote that cannot be reached does not keep the
#    others from being pruned.
#  * deletes each ref under `refs/remotes/` that belongs to no configured
#    remote and that no remote's fetch refspec names, such as
#    `refs/remotes/pr/123`, unless its reflog says that it was updated within
#    the last day, as when a tool such as `pr-merge-analysis` is using it.
#    `git remote prune` never deletes such a ref.
#  * deletes each local branch that is gone from its remote and that no
#    worktree has checked out, if every commit on it is on some other ref or
#    if its changes have landed, as `git-outgoing --omitted` decides.  Neither
#    another branch that this step would delete nor a ref that the previous
#    step kept only because it is recent counts as such a ref.
#  * removes each linked worktree whose directory is gone and whose branch is
#    gone from its remote.  `git-remove-branch-directory` removes the
#    registration, deletes the branch if `git-new-branch` or
#    `git-checkout-branch` created it, and refuses if that would lose commits.
#    A worktree with a detached HEAD is left alone, because nothing indicates
#    that its work is done:  it might have been moved with `mv` and not yet
#    repaired, and removing its registration would make the repair
#    impossible.
# Fails if any step fails.
prune_stale_branches() {
  prune_status=0

  # `git fetch` with no arguments fetches the remote of the current branch,
  # or origin if the current branch has none.
  fetched_remote="$(git config "branch.$(git symbolic-ref --short -q HEAD).remote" 2> /dev/null)" \
    || fetched_remote=origin
  for remote in $(git remote); do
    if [ "$remote" != "$fetched_remote" ]; then
      git remote prune "$remote" > /dev/null || prune_status=1
    fi
  done

  # The destinations of the remotes' fetch refspecs, such as
  # "refs/remotes/origin/*".
  fetch_destinations="$(git config --get-regexp '^remote\..*\.fetch$' \
    | sed -n 's/^[^ ]* +\{0,1\}[^:]*:\(.*\)$/\1/p')"
  orphan_refs="$(git for-each-ref --format='%(refname)' refs/remotes \
    | remotes="$(git remote)" destinations="$fetch_destinations" awk '
      BEGIN {
        n = split(ENVIRON["remotes"], remote, "\n")
        m = split(ENVIRON["destinations"], destination, "\n")
      }
      {
        for (i = 1; i <= n; i++) {
          if (index($0, "refs/remotes/" remote[i] "/") == 1) next
        }
        for (i = 1; i <= m; i++) {
          star = index(destination[i], "*")
          if (star == 0) {
            if ($0 == destination[i]) next
            continue
          }
          prefix = substr(destination[i], 1, star - 1)
          suffix = substr(destination[i], star + 1)
          if (length($0) >= length(prefix) + length(suffix) &&
            index($0, prefix) == 1 &&
            substr($0, length($0) - length(suffix) + 1) == suffix) next
        }
        print
      }')"
  now="$(date +%s)"
  stale_orphan_refs=""
  recent_orphan_refs=""
  for ref in $orphan_refs; do
    # `%gd` is "NAME@{TIME}".
    updated="$(git reflog show -1 --date=unix --format=%gd "$ref" -- 2> /dev/null \
      | sed -n 's/.*@{\([0-9]*\)}$/\1/p')"
    if [ -n "$updated" ] && [ $((now - updated)) -lt 86400 ]; then
      recent_orphan_refs="$recent_orphan_refs $ref"
    else
      stale_orphan_refs="$stale_orphan_refs $ref"
    fi
  done
  if [ -n "$stale_orphan_refs" ]; then
    # shellcheck disable=SC2086 # $stale_orphan_refs is a list of refs
    printf 'delete %s\n' $stale_orphan_refs \
      | git update-ref --no-deref --stdin || prune_status=1
  fi

  # A branch that a worktree has checked out, even a worktree whose directory
  # is gone, yields an empty line.
  gone_branches="$(git for-each-ref \
    --format='%(if)%(worktreepath)%(then)%(else)%(refname:lstrip=2) %(upstream:track)%(end)' \
    refs/heads | awk '$2 == "[gone]" { print $1 }')"
  if [ -n "$gone_branches" ]; then
    unheld_excludes=""
    for branch in $gone_branches; do
      unheld_excludes="$unheld_excludes --exclude=refs/heads/$branch"
    done
    for ref in $recent_orphan_refs; do
      unheld_excludes="$unheld_excludes --exclude=$ref"
    done
    unheld_branches=""
    for branch in $gone_branches; do
      # shellcheck disable=SC2086 # $unheld_excludes is a list of arguments
      if [ "$(git rev-list --count "refs/heads/$branch" --not $unheld_excludes --all)" != 0 ]; then
        unheld_branches="$unheld_branches $branch"
      fi
    done
    landed_branches=""
    if [ -n "$unheld_branches" ]; then
      # shellcheck disable=SC2046,SC2086 # each word is an argument
      if outgoing="$(git-outgoing $(printf ' --only-branch=%s' $unheld_branches) --omitted)"; then
        landed_branches="$(printf '%s\n' "$outgoing" | sed 's|^refs/heads/||')"
      else
        prune_status=1
      fi
    fi
    deletable_branches=""
    for branch in $gone_branches; do
      case " $unheld_branches " in
        *" $branch "*)
          printf '%s\n' "$landed_branches" | grep -q -x -F -e "$branch" || continue
          ;;
      esac
      deletable_branches="$deletable_branches $branch"
    done
    if [ -n "$deletable_branches" ]; then
      # shellcheck disable=SC2086 # $deletable_branches is a list of arguments
      git branch -D -q $deletable_branches || prune_status=1
    fi
  fi

  # Each line is "BRANCH PATH" for a worktree whose directory is gone and that
  # has a branch checked out.
  git worktree list --porcelain | awk '
    /^worktree / { path = substr($0, 10); branch = ""; prunable = 0 }
    /^branch refs\/heads\// { branch = substr($0, 19) }
    /^prunable/ { prunable = 1 }
    /^$/ { if (prunable && branch != "") print branch " " path; prunable = 0 }
    END { if (prunable && branch != "") print branch " " path }' \
    | {
      remove_status=0
      while read -r branch path; do
        if [ "$(git for-each-ref --format='%(upstream:track)' "refs/heads/$branch")" = "[gone]" ]; then
          git-remove-branch-directory --repository . -- "$path" || remove_status=1
        fi
      done
      exit "$remove_status"
    } || prune_status=1

  return "$prune_status"
}

# Use this for non-github repositories.
update_from() {
  upstream=$1
  dir=$2
  if [ -d "$dir" ]; then
    (cd "$dir" \
      && make_merges_fast_forward_only \
      && git pull -q --ff-only --prune \
      && git pull -q --ff-only "$upstream" --tags \
      && git push -q \
      && prune_stale_branches) || (echo "$dir" && false)
  fi
}

submodule_update() {
  dir="$1"
  if [ -d "$dir" ]; then
    (cd "$dir" && git submodule update --init --recursive)
  fi
}

