## Weird: using `--tags` causes the pull to fail.
# update_fork JetBrains kotlin ~/java
## So do it directly:
dir=~/java/kotlin-fork-mernst
if [ -d $dir ]; then
  (cd $dir \
    && make_merges_fast_forward_only \
    && git pull -q --ff-only --prune \
    && git pull -q --ff-only "git@github.com:JetBrains/kotlin" \
    && git push -q \
    && prune_stale_branches) || (echo "$dir" && false)
fi

