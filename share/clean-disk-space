#!/bin/bash
# Recover disk space on the root filesystem (the SSD) by deleting caches and
# stale data that tools regenerate on demand.
# Usage:  clean-disk-space [--dry-run]
# Steps that need root run via sudo at the end; sudo prompts for a password.

set -uo pipefail

dry_run=false
if [ "${1-}" = "--dry-run" ]; then
  dry_run=true
fi

# Print a command, and run it unless this is a dry run.
run() {
  echo "+ $*"
  if ! $dry_run; then
    "$@" || echo "  (failed with status $?; continuing)"
  fi
}

# Print the size of each existing path argument.
show_size() {
  du -sh "$@" 2>/dev/null | sed 's/^/  /'
}

# Delete the files under directory $1 that were last read more than $2 days
# ago, then delete the directories that this leaves empty.
delete_unread_files() {
  [ -d "$1" ] || return 0
  local size
  size=$(find "$1" -type f -atime +"$2" -printf '%s\n' | awk '{s+=$1} END {printf "%.2f GB", s/1e9}')
  echo "  $size in files unread for more than $2 days"
  if $dry_run; then
    echo "+ find $1 -type f -atime +$2 -delete"
  else
    find "$1" -type f -atime +"$2" -delete
    find "$1" -mindepth 1 -type d -empty -delete
  fi
}

df -h /
echo

### Eclipse JDT language server workspaces, except those of running servers.
### A deleted workspace is rebuilt when an editor next opens its project.
echo "== ~/.cache/jdtls workspaces"
in_use=$(for p in $(pgrep -u "$USER" -f org.eclipse.jdt.ls.core); do
           tr '\0' '\n' < "/proc/$p/cmdline" | grep -A1 -x -- -data | tail -n 1
         done)
for ws in "$HOME"/.cache/jdtls/jdtls-*; do
  [ -d "$ws" ] || continue
  if grep -qxF "$ws" <<< "$in_use"; then
    echo "  Keeping $ws (in use)"
  else
    run rm -rf "$ws"
  fi
done

### Stale GNOME file-indexer database.  localsearch-3.service is masked, and
### localsearch uses a different directory.
echo "== ~/.cache/tracker3 (stale)"
show_size "$HOME/.cache/tracker3"
run rm -rf "$HOME/.cache/tracker3"

### Package-manager and tool caches.
echo "== uv cache (pruning unreachable entries, such as those of older uv versions)"
run uv cache prune
echo "== prek cache (removing unused hook environments)"
run prek cache gc
echo "== pip cache"
delete_unread_files "$HOME/.cache/pip" 30
echo "== gh cache (such as downloaded workflow logs)"
delete_unread_files "$HOME/.cache/gh" 30
echo "== npm cache"
run npm cache clean --force

### Build output that has not been written for 30 days, in the git working
### copy directories under ~/research and ~/java.  A directory named "build"
### or "target", up to 3 levels below a working copy directory's top, is
### deleted only if git ignores it and it contains no tracked files.  The
### next build in that working copy directory regenerates it.
echo "== Build output not written for 30 days"
find "$HOME/research" "$HOME/java" -maxdepth 5 \
     \( -name build -o -name target -o -name node_modules -o -name .venv \) -prune \
     -o -name .git -print 2>/dev/null |
  while IFS= read -r git_path; do
    wc=$(dirname "$git_path")
    find "$wc" -mindepth 1 -maxdepth 3 \
         \( -name .git -o -name node_modules -o -name .venv \) -prune \
         -o -type d \( -name build -o -name target \) -prune -print 2>/dev/null |
      while IFS= read -r dir; do
        rel=${dir#"$wc"/}
        git -C "$wc" check-ignore -q -- "$rel" 2>/dev/null || continue
        [ -z "$(git -C "$wc" ls-files -- "$rel" 2>/dev/null | head -n 1)" ] || continue
        [ -z "$(find "$dir" -mtime -30 -print -quit 2>/dev/null)" ] || continue
        show_size "$dir"
        run rm -rf "$dir"
      done
  done

### Steps that need root.
echo "== systemd journal (keeping the newest 500 MB)"
run sudo journalctl --vacuum-size=500M

echo "== Disabled snap revisions"
run sudo snap set system refresh.retain=2
snap list --all | awk '/disabled/ {print $1, $3}' |
  while read -r name rev; do
    run sudo snap remove "$name" --revision="$rev"
  done

echo "== apt: downloaded packages and packages no longer needed (such as old kernels)"
run sudo apt-get clean
run sudo apt-get autoremove --purge

echo
df -h /
